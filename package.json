{
  "name": "@birb/react-foundation",
  "version": "0.1.0",
  "description": "Shared design tokens, base styles, theme switching, browser-session client and form primitives for Birb React applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattsp1290/react-foundation.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "css",
    "README.md",
    "DESIGN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./base.css": "./css/base.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "verify:pack": "sh scripts/verify-pack.sh",
    "e2e": "npm --prefix catalog ci && npm --prefix catalog run typecheck && playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && node scripts/generate-tokens.mjs --check && npm run test && npm run build && npm run verify:pack && npm run e2e"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.3",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "2.1.9"
  }
}
